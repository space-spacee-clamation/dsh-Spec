{
  "name": "dsh-spec",
  "version": "0.12.0",
  "private": true,
  "description": "OpenSpec 原生语义的 DSH 前端：原生 schema/artifact 状态、多角色任务编排（产品/设计/开发/测试独立模型会话）、内置 12 个 OPSX 工作流 skills（MIT 标注）、AI sync/archive 与确定性快路径、/opsx-* 命令与工作区面板（不依赖 openspec CLI）。",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/space-spacee-clamation/dsh-Spec.git"
  },
  "homepage": "https://github.com/space-spacee-clamation/dsh-Spec",
  "bugs": {
    "url": "https://github.com/space-spacee-clamation/dsh-Spec/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "tools",
    "tests",
    "docs",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "license": "MIT"
}
